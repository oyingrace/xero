# Set to the deployed TicTacToe contract address (see contracts/).
# Until this is set, the app runs the identical game engine locally
# ("demo mode") so it's playable without a deployed contract.
NEXT_PUBLIC_TIC_TAC_TOE_CONTRACT_ADDRESS=

# Set to "true" to run against Celo Alfajores testnet instead of mainnet.
NEXT_PUBLIC_USE_TESTNET=false
